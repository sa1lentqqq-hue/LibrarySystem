<UserControl x:Class="LibrarySystem.Controls.AnimatedBackground"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SizeChanged="OnSizeChanged" IsHitTestVisible="False">
    <!-- Фон в стиле библиотеки. Анимируется сам, без участия пользователя:
         1) градиент «тёмное дерево ↔ зелёное сукно»; 2) «дышащий» свет лампы;
         3) падающие листы бумаги (создаются в коде); 4) книжная полка внизу. -->
    <Grid ClipToBounds="True">
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop x:Name="StopA" Color="#281C16" Offset="0"/>
                    <GradientStop x:Name="StopB" Color="#4E3422" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Ellipse x:Name="Lamp" Width="760" Height="560" HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-260,-160,0" Opacity="0.35">
            <Ellipse.CacheMode>
                <BitmapCache/>
            </Ellipse.CacheMode>
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#E6B45A" Offset="0"/>
                    <GradientStop Color="#00E6B45A" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Canvas x:Name="PagesLayer"/>
        <Canvas x:Name="ShelfLayer" Height="110" VerticalAlignment="Bottom">
            <Canvas.CacheMode>
                <BitmapCache/>
            </Canvas.CacheMode>
        </Canvas>
    </Grid>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="UserControl.Loaded">
            <BeginStoryboard x:Name="BackgroundStory">
                <Storyboard>
                    <ColorAnimation Storyboard.TargetName="StopA" Storyboard.TargetProperty="Color"
                                    From="#281C16" To="#223A2E" Duration="0:0:9" AutoReverse="True" RepeatBehavior="Forever"/>
                    <ColorAnimation Storyboard.TargetName="StopB" Storyboard.TargetProperty="Color"
                                    From="#4E3422" To="#281C16" Duration="0:0:9" AutoReverse="True" RepeatBehavior="Forever"/>
                    <DoubleAnimation Storyboard.TargetName="Lamp" Storyboard.TargetProperty="Opacity"
                                     From="0.25" To="0.5" Duration="0:0:4" AutoReverse="True" RepeatBehavior="Forever"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
        <!-- когда фон убран с экрана, анимации останавливаются и не расходуют процессор -->
        <EventTrigger RoutedEvent="FrameworkElement.Unloaded">
            <StopStoryboard BeginStoryboardName="BackgroundStory"/>
        </EventTrigger>
    </UserControl.Triggers>
</UserControl>
