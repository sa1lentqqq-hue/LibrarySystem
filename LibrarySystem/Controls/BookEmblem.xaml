<UserControl x:Class="LibrarySystem.Controls.BookEmblem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="48" Height="40" IsHitTestVisible="False">
    <!-- Эмблема: раскрытая книга, нарисованная векторными фигурами (без картинок) -->
    <Viewbox Stretch="Uniform">
        <Canvas Width="48" Height="40">
            <Path Fill="{StaticResource BrassBrush}" Data="M24,14 L1,7 L1,37 L24,40 Z"/>
            <Path Fill="{StaticResource BrassBrush}" Data="M24,14 L47,7 L47,37 L24,40 Z"/>
            <Path Fill="{StaticResource CardBrush}" Data="M24,10 L3,4 L3,32 L24,37 Z"/>
            <Path Fill="{StaticResource CardBrush}" Data="M24,10 L45,4 L45,32 L24,37 Z"/>
            <Path Stroke="{StaticResource AccentBrush}" StrokeThickness="1.6" Data="M24,10 L24,37"/>
            <Path Stroke="{StaticResource MutedBrush}" StrokeThickness="1" Opacity="0.6"
                  Data="M7,12 L21,16 M7,18 L21,22 M7,24 L21,28 M41,12 L27,16 M41,18 L27,22 M41,24 L27,28"/>
        </Canvas>
    </Viewbox>
</UserControl>
