<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>   
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LibrarySystem</RootNamespace>
    <AssemblyName>LibrarySystem</AssemblyName>
    <Version>2.3.0</Version>
    <Authors>Дейнеко Артур Сергеевич</Authors> 
    <Product>Библиотечная система</Product>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>  
  </PropertyGroup>

  <ItemGroup>
    <!-- SQLite для .NET (устанавливается автоматически из NuGet) -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Значок приложения: в проводнике, на панели задач и в окнах -->
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Схема БД, тестовые данные и обновления схемы копируются рядом с программой -->
    <None Update="Data\*.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
