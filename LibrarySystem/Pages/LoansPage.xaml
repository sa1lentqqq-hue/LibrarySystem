<UserControl x:Class="LibrarySystem.Pages.LoansPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:LibrarySystem.Controls">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Выдача книги -->
        <Border Style="{StaticResource Card}" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Читатель:" Style="{StaticResource Label}" Margin="0,0,8,0"/>
                <ComboBox x:Name="ReaderBox" Grid.Column="1" Style="{StaticResource InputCombo}" Margin="0,0,18,0"/>
                <TextBlock Grid.Column="2" Text="Книга:" Style="{StaticResource Label}" Margin="0,0,8,0"/>
                <ComboBox x:Name="BookBox" Grid.Column="3" Style="{StaticResource InputCombo}"/>
                <Button Grid.Column="4" Content="Выдать книгу" Style="{StaticResource BrassButton}"
                        MinWidth="150" Margin="18,0,0,0" Click="OnIssue"/>
            </Grid>
        </Border>

        <!-- Действия -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,10">
            <Button Content="Принять возврат" Style="{StaticResource SuccessButton}" Margin="0,0,8,0" Click="OnReturn"/>
            <Button Content="Продлить на 7 дн." Style="{StaticResource WoodButton}" Margin="0,0,8,0" Click="OnRenew"/>
            <Button Content="Книга утеряна" Style="{StaticResource DangerButton}" Margin="0,0,8,0" Click="OnLost"/>
            <Button Content="Книга нашлась" Style="{StaticResource GreenButton}" Click="OnFound"/>
        </StackPanel>

        <!-- Поиск, фильтр по статусу и сортировка -->
        <c:FilterBar x:Name="Filter" Grid.Row="2" Margin="0,0,0,8"/>

        <!-- Просроченные выдачи подсвечиваются красным, возвращённые — серым -->
        <DataGrid x:Name="LoansGrid" Grid.Row="3" Style="{StaticResource LibraryGrid}">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding [Статус]}" Value="Просрочена">
                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding [Статус]}" Value="Возвращена">
                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>
    </Grid>
</UserControl>
