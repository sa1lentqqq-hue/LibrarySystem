<UserControl x:Class="LibrarySystem.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:LibrarySystem.Controls">
    <Grid>
        <c:AnimatedBackground/>
        <!-- снизу оставлено место, чтобы была видна книжная полка -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,0,110">
            <StackPanel Margin="24,18,24,10">

                <!-- Плашка про просрочку (красная — есть просроченные, зелёная — всё в порядке); по щелчку открывает список -->
                <Border x:Name="AlertHost" Margin="6,0,6,14"/>

                <!-- Быстрый переход: пилюли разделов с иконками; плавно подсвечиваются латунью и слегка «приподнимаются» -->
                <WrapPanel x:Name="NavPanel" Margin="2,0,2,14"/>

                <!-- Показатели библиотеки -->
                <TextBlock x:Name="StatsHeader" Text="Библиотека сегодня" Style="{StaticResource H1}" Foreground="White" Margin="6,0,0,10"/>
                <WrapPanel x:Name="StatsPanel"/>

                <!-- Диаграммы -->
                <TextBlock x:Name="ChartsHeader" Text="Динамика выдач" Style="{StaticResource H1}" Foreground="White" Margin="6,20,0,10"/>
                <WrapPanel x:Name="ChartsPanel"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
