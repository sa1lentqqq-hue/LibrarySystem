<UserControl x:Class="LibrarySystem.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:LibrarySystem.Controls">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="460"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Сведения о программе и авторе -->
        <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,16,0" VerticalAlignment="Top">
            <StackPanel>
                <Border Height="5" Background="{StaticResource AccentBrush}"/>
                <StackPanel Margin="26,20,26,26">
                    <StackPanel Orientation="Horizontal">
                        <c:BookEmblem Margin="0,0,14,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Библиотечная система" Style="{StaticResource H1}" FontSize="22"/>
                            <TextBlock x:Name="VersionText" Style="{StaticResource Muted}"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="AuthorText" FontWeight="SemiBold" FontSize="16" Margin="0,22,0,4"/>
                    <TextBlock x:Name="GroupText" FontWeight="SemiBold" FontSize="16"/>
                    <TextBlock Text="Учёт книжного фонда, читателей, выдачи книг и штрафов за просрочку."
                               TextWrapping="Wrap" Margin="0,16,0,0"/>
                    <TextBlock Text="Технологии: C#, .NET 8, WPF, SQLite" Style="{StaticResource Muted}" Margin="0,16,0,0"/>
                    <TextBlock Text="Шрифты: Georgia (заголовки), Segoe UI (текст)" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                    <Button Content="Копировать сведения" Style="{StaticResource WoodButton}"
                            HorizontalAlignment="Left" Margin="0,22,0,0" Click="OnCopy"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Состояние базы данных -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Content="Обновить" Style="{StaticResource BrassButton}" Click="OnRefresh"/>
                <TextBlock Text="Состояние базы данных" Style="{StaticResource H2}" VerticalAlignment="Center"/>
            </DockPanel>
            <DataGrid x:Name="StatsGrid" Grid.Row="1" Style="{StaticResource LibraryGrid}"/>
        </Grid>
    </Grid>
</UserControl>
