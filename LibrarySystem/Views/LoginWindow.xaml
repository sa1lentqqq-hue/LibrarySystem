<Window x:Class="LibrarySystem.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:LibrarySystem.Controls"
        Title="Библиотечная система — вход" Width="960" Height="640" MinWidth="720" MinHeight="580"
        WindowStartupLocation="CenterScreen" Style="{StaticResource AppWindow}" Loaded="OnLoaded">
    <Grid x:Name="Root" Opacity="0">
        <c:AnimatedBackground/>

        <!-- Карточка входа «въезжает» сверху и плавно проявляется -->
        <Border x:Name="Card" Style="{StaticResource Card}" Padding="0" Width="400"
                HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.5"/>
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="CardShift" Y="-520"/>
            </Border.RenderTransform>
            <StackPanel>
                <Border Height="5" Background="{StaticResource AccentBrush}"/>
                <StackPanel Margin="30,22,30,30">
                    <StackPanel Orientation="Horizontal">
                        <c:BookEmblem Margin="0,0,14,0"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Библиотечная система" Style="{StaticResource H2}"/>
                            <TextBlock Text="Вход в систему" Style="{StaticResource Muted}"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Логин" Style="{StaticResource Label}" Margin="0,24,0,4"/>
                    <TextBox x:Name="LoginBox" Style="{StaticResource InputBox}"/>

                    <TextBlock Text="Пароль" Style="{StaticResource Label}" Margin="0,14,0,4"/>
                    <Grid>
                        <PasswordBox x:Name="PassBox" MinHeight="32" Padding="6,4" VerticalContentAlignment="Center"/>
                        <TextBox x:Name="PassText" Style="{StaticResource InputBox}" Visibility="Collapsed"/>
                    </Grid>
                    <CheckBox x:Name="ShowPass" Content="Показать пароль" Margin="0,10,0,0"
                              Checked="OnShowPass" Unchecked="OnShowPass"/>

                    <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                               Margin="0,10,0,0" MinHeight="20"/>
                    <Button Content="Войти" IsDefault="True" Style="{StaticResource BrassButton}"
                            Height="44" Margin="0,8,0,0" Click="OnLogin"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
