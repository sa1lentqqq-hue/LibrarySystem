<Window x:Class="LibrarySystem.Views.EditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="540" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Style="{StaticResource AppWindow}" Loaded="OnLoaded">
    <DockPanel x:Name="Root" Margin="22">
        <DockPanel.RenderTransform>
            <TranslateTransform x:Name="Shift" Y="24"/>
        </DockPanel.RenderTransform>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Сохранить" IsDefault="True" Style="{StaticResource BrassButton}"
                    Width="130" Margin="0,0,10,0" Click="OnSave"/>
            <Button Content="Отмена" IsCancel="True" Style="{StaticResource MutedButton}" Width="110"/>
        </StackPanel>
        <Grid x:Name="Form"/>
    </DockPanel>
</Window>
